<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenFreq.Client.Controls.AudioChannelSelector"
             x:Name="Root">

    <StackPanel Width="150" Spacing="0">

        <!-- Slider row: L [====O====] R -->
        <Grid ColumnDefinitions="18,*,18" VerticalAlignment="Center">
            <TextBlock Grid.Column="0"
                       Text="L"
                       FontSize="11" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialBodyBrush}"
                       Opacity="0.55"
                       Margin="0,6,0,0" />
            <Slider Grid.Column="1"
                    Minimum="-100" Maximum="100"
                    Classes="Accent"
                    Value="{Binding #Root.Pan}"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    TickPlacement="None"
                    SmallChange="10"
                    LargeChange="50"
                    Margin="0,6,0,0" />
            <TextBlock Grid.Column="2"
                       Text="R"
                       FontSize="11" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource MaterialBodyBrush}"
                       Opacity="0.55"
                       Margin="0,6,0,0" />
        </Grid>

        <!-- Numeric value, centred, dimmed -->
        <TextBlock Text="{Binding #Root.Pan}"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MaterialBodyBrush}"
                   Opacity="0.5"
                   Margin="0,-2,0,0" />

    </StackPanel>

</UserControl>
