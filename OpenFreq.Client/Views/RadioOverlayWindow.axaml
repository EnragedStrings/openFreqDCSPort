<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenFreqClient.ViewModels"
        xmlns:converters="clr-namespace:OpenFreqClient.Converters"
        x:Class="OpenFreqClient.Views.RadioOverlayWindow"
        x:DataType="vm:RadioOverlayViewModel"
        Title="OpenFreq Overlay"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="Height"
        Width="240"
        WindowStartupLocation="Manual"
        Focusable="False">

    <Window.Resources>
        <converters:ChannelTransmissionStatusToColorConverter x:Key="ChannelTransmissionStatusToColorConverter" />
    </Window.Resources>

    <Border Background="#C0101014" CornerRadius="8" Padding="10" PointerPressed="OnBorderPointerPressed">
        <StackPanel MinWidth="200">
            <TextBlock Text="No radios tuned"
                       Foreground="White"
                       Opacity="0.6"
                       FontSize="12"
                       IsVisible="{Binding !DisplayedChannels.Count}" />

            <ItemsControl ItemsSource="{Binding DisplayedChannels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChannelCardViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,2,8,0" VerticalAlignment="Top"
                                     Fill="{Binding TransmissionStatus, Converter={StaticResource ChannelTransmissionStatusToColorConverter}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold" FontSize="12"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FrequencyDisplayText}"
                                           FontSize="11" Opacity="0.75"
                                           Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
