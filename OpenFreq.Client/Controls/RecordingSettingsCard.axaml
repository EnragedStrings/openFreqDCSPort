<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:OpenFreqClient.ViewModels"
             x:Class="OpenFreq.Client.Controls.RecordingSettingsCard"
             x:DataType="vm:MainWindowViewModel">

  <controls:Card>
    <StackPanel Margin="16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <avalonia:MaterialIcon Kind="FileDownloadOutline"
                               Width="16" Height="16"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
        <TextBlock Text="Recording/Streaming" Classes="SectionHeader" Margin="0" />
      </StackPanel>

      <TextBlock Text="Trigger" Classes="Caption" Opacity="0.6" Margin="0,0,0,4" />

      <StackPanel>
        <RadioButton Content="Start/Stop recording manually"
                     IsChecked="{Binding !Settings.AutoRecordInGameMode}"
                     Margin="0,0,0,2" />

        <RadioButton Content="Start recording automatically on connect"
                     IsChecked="{Binding Settings.AutoRecordInGameMode}"
                     Margin="0,0,0,4" />
      </StackPanel>

      <TextBlock Text="Output" Classes="Caption" Opacity="0.6" Margin="0,12,0,4" />
      <StackPanel>
        <RadioButton Content="Record to file"
                     IsChecked="{Binding Settings.StreamToDevice, Converter={StaticResource InverseBool}}"
                     Margin="0,0,0,2" />
      </StackPanel>
      <!-- File sink: output folder -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Settings.RecordToFile}">
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialBackgroundBrush}"
                BorderBrush="{DynamicResource MaterialDividerBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                ToolTip.Tip="{Binding Settings.RecordingPath}">
          <TextBlock Text="{Binding Settings.RecordingPath}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Settings.HeightmapPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Border>
        <Button Grid.Column="1"
                Click="BrowseFolder_OnClick"
                Padding="12,8"
                Margin="8,0,0,0">
          <avalonia:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
        </Button>
      </Grid>
      <RadioButton Content="Stream to device"
                   IsChecked="{Binding Settings.StreamToDevice}"
                   Margin="0,0,0,8" />
      <!-- Device sink: monitor/stream output device -->

      <ComboBox IsVisible="{Binding Settings.StreamToDevice}"
                ItemsSource="{Binding Settings.PlaybackDeviceNames}"
                SelectedIndex="{Binding Settings.MonitorDeviceIndex}"
                HorizontalAlignment="Stretch" />

      <TextBlock Classes="InputLabel" Margin="0,12,0,4">
        <Run Text="SFX on my voice: " />
        <Run Text="{Binding Settings.OwnVoiceSfxVolume, StringFormat={}{0:P0}}" />
      </TextBlock>
      <Slider Minimum="0" Maximum="1"
              Value="{Binding Settings.OwnVoiceSfxVolume}"
              TickFrequency="0.05"
              IsSnapToTickEnabled="True"
              Margin="0,0,0,4" />

      <TextBlock Classes="InputLabel" Margin="0,8,0,4" Text="Mask effect profile" />
      <ComboBox ItemsSource="{Binding Settings.MaskEffectProfileNames}"
                SelectedIndex="{Binding Settings.MaskEffectProfileIndex}"
                HorizontalAlignment="Stretch"
                ToolTip.Tip="The oxygen-mask sound on your own voice and the hot mic in your recording / HUD tape, for the jet types (A-10C, F-16, F-15, generic jet). 1 = measured mask (mask cavity measured from a real recording, then the intercom chain). 2 = the classic mask. Local only: what other players hear is unchanged."
                Margin="0,0,0,8" />

      <CheckBox Content="Feed HUD Recorder (DCS HUD tapes)"
                IsChecked="{Binding Settings.HudTapeFeedEnabled}"
                IsVisible="{Binding Settings.IsWindowsPlatform}"
                ToolTip.Tip="Puts the radios (as heard, plus your own voice in your mask and cockpit) on HUD Recorder's DCS HUD tapes, in sync. Local shared memory only, nothing leaves this PC. Runs whenever OpenFreq plays audio, independent of recording/streaming. The tape level follows Master Volume."
                Margin="0,0,0,4" />
      <CheckBox Content="Hot mic on the HUD tape"
                IsChecked="{Binding Settings.HudTapeHotMicEnabled}"
                IsEnabled="{Binding Settings.HudTapeFeedEnabled}"
                IsVisible="{Binding Settings.IsWindowsPlatform}"
                ToolTip.Tip="Your mic is on the HUD tape the whole time, not only while you transmit. While you transmit the tape has your voice as the radio sends it instead, with a short crossfade at the PTT. HUD tape only: never transmitted, not in sidetone, the session recording or the stream. Needs Feed HUD Recorder."
                Margin="20,0,0,4" />


    </StackPanel>
  </controls:Card>

</UserControl>
